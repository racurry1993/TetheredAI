#install.packages("recommenderlab")
library(recommenderlab)
library(dplyr)
data(MovieLense)
movie_ids <- c(1,11,12,22,23,29,50,56,64,71,82,88,94,96,98)
my_ratings <- c(3, 4, 5, 4, 3, 2, 5, 5, 5, 3, 4, 2, 1, 5, 4)
new_user_matrix <- matrix(my_ratings,
nrow=1,
ncol=length(movie_ids),
dimnames = list(user="MyUser", item=colnames(MovieLense)[movie_ids]))
new_user_ratings <- as(new_user_matrix, "realRatingMatrix")
cat("✅ Personalized ratings matrix created and converted to realRatingMatrix.\n")
rec_ubcf <- Recommender(MovieLense, method = "UBCF",
param = list(normalize = "Z-score",
method = "Cosine",
nn = 25))
cat("✅ UBCF model trained on MovieLense data.\n")
# --- 2. Predict Top 10 Movies for the New User ---
# We use the trained model to predict ratings for your 'new_user_ratings' data.
# type = "topNList" returns a list of the n=10 best items.
top_n <- 10
prediction <- predict(rec_ubcf,
new_user_ratings,
n = top_n,
type = "topNList")
new_user_ratings
#install.packages("recommenderlab")
library(recommenderlab)
library(dplyr)
data(MovieLense)
movie_ids <- c(1, 11, 12, 22, 23, 29, 50, 56, 64, 71, 82, 88, 94, 96, 98)
# *** IMPORTANT: Use your actual ratings here ***
my_ratings <- c(3, 4, 5, 4, 3, 2, 5, 5, 5, 3, 4, 2, 1, 5, 4)
# --- 2. Create a TEMPORARY vector of NA for all 1664 movies ---
# Get ALL item IDs (column names) from the MovieLense model
all_movie_ids <- colnames(MovieLense)
num_items <- length(all_movie_ids)
# Start with a vector of NA ratings for all items
full_ratings_vector <- rep(NA, num_items)
names(full_ratings_vector) <- all_movie_ids
# --- 3. Inject Your Ratings into the Full Vector ---
# Map your 15 ratings to the correct movie IDs (names)
# This step ensures your 15 ratings are placed correctly among the 1664 items.
rated_item_names <- all_movie_ids[movie_ids]
full_ratings_vector[rated_item_names] <- my_ratings
# --- 4. Create the final RealRatingMatrix for prediction ---
# Create the matrix with 1 row and 1664 columns
new_user_matrix_full <- matrix(full_ratings_vector,
nrow = 1,
ncol = num_items,
dimnames = list(user = "MyUser", item = all_movie_ids))
# Convert to the required format
new_user_ratings <- as(new_user_matrix_full, "realRatingMatrix")
cat("✅ New user's ratings matrix successfully aligned to the model structure.\n")
cat(paste("Matrix dimensions for prediction:", dim(new_user_ratings)[1], "users x", dim(new_user_ratings)[2], "items.\n"))
# --------------------------------------------------------------------
# --- Re-Run the Prediction Step (Assuming 'rec_ubcf' is already trained) ---
# --------------------------------------------------------------------
# If you closed R, make sure to re-run the UBCF model training first!
# rec_ubcf <- Recommender(MovieLense, method = "UBCF",
#                         param = list(normalize = "Z-score", method = "Cosine", nn = 25))
top_n <- 10
prediction <- predict(rec_ubcf,
new_user_ratings,
n = top_n,
type = "topNList")
cat(paste0("\n✅ Top ", top_n, " recommendations successfully predicted for MyUser.\n"))
# --- Display the List of Recommended Movies (as per previous code) ---
recommended_movie_ids <- as.character(unlist(prediction@items))
data(MovieLenseMeta)
recommended_movies <- MovieLenseMeta %>%
filter(item_id %in% recommended_movie_ids) %>%
select(movie_title, release_date) %>%
mutate(Rank = match(item_id, recommended_movie_ids)) %>% # Match item_id order to prediction
arrange(Rank) %>%
select(Rank, movie_title, release_date)
