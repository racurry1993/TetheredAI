# --- Display the List of Recommended Movies (as per previous code) ---
recommended_movie_ids <- as.character(unlist(prediction@items))
# Get the metadata for the recommended movies
data(MovieLenseMeta)
# Create a final list of recommended movie names
recommended_movies <- MovieLenseMeta %>%
# FIX 1: Change 'item_id' to 'movie_id' (or check your actual column name)
filter(movie_id %in% recommended_movie_ids) %>%
select(movie_title, release_date, movie_id) %>% # Keep movie_id for matching
# FIX 2: Ensure the matching uses the correct column name 'movie_id'
mutate(Rank = match(movie_id, recommended_movie_ids)) %>%
arrange(Rank) %>%
select(Rank, movie_title, release_date)
#install.packages("recommenderlab")
library(recommenderlab)
library(dplyr)
data(MovieLense)
fix(MovieLenseMeta)
fix(MovieLenseUser)
getRatingMatrix(MovieLense)
myrating <- matrix(NA, 1, 1664)
myrating[c(1,2,3,4,5)] <- c(3,5,5,4,4)
myrating<-as(myrating, "realRatingMatrix")
rec.ub <- Recommender(MovieLense, "UBCF")
pred.ub <- predict(rec.ub, myrating, n=10, type="topNList")
as(pred.ub, "list")
#install.packages("recommenderlab")
library(recommenderlab)
library(dplyr)
data(MovieLense)
fix(MovieLenseMeta)
fix(MovieLenseUser)
getRatingMatrix(MovieLense)
myrating <- matrix(NA, 1, 1664)
myrating[c(1,2,3,4,5)] <- c(3,5,5,4,4)
myrating<-as(myrating, "realRatingMatrix")
rec.ub <- Recommender(MovieLense, "UBCF")
pred.ub <- predict(rec.ub, myrating, n=10, type="topNList")
as(pred.ub, "list")
# The 15 movies specified in the homework and their MovieLense IDs (Row Index)
movie_ids_to_rate <- c(
# Row Index Movie Name
1,   # Toy Story (1995)
11,  # Seven (Se7en) (1995)
12,  # Usual Suspects, The (1995)
22,  # Braveheart (1995)
23,  # Taxi Driver (1976)
29,  # Batman Forever (1995)
50,  # Star Wars (1977)
56,  # Pulp Fiction (1994)
64,  # Shawshank Redemption, The (1994)
71,  # Lion King, The (1994)
82,  # Jurassic Park (1993)
88,  # Sleepless in Seattle (1993)
94,  # Home Alone (1990)
96,  # Terminator 2: Judgment Day (1991)
98   # Silence of the Lambs, The (1991)
)
# *** IMPORTANT: Replace these dummy ratings (1-5) with your actual preferences ***
my_15_ratings <- c(
4,  # Toy Story
5,  # Seven (Se7en)
5,  # Usual Suspects, The
4,  # Braveheart
3,  # Taxi Driver
2,  # Batman Forever
5,  # Star Wars
5,  # Pulp Fiction
5,  # Shawshank Redemption, The
4,  # Lion King, The
3,  # Jurassic Park
2,  # Sleepless in Seattle
1,  # Home Alone
5,  # Terminator 2: Judgment Day
5   # Silence of the Lambs, The
)
# ----------------------------------------------------------------------
# STEP 2: Create the Aligned realRatingMatrix for Prediction
# (Crucial step to avoid the "number of items does not match model" error)
# ----------------------------------------------------------------------
# 1. Start with an NA vector covering ALL 1664 movies in the model
all_movie_ids <- colnames(MovieLense)
my_rating_vector <- rep(NA, length(all_movie_ids))
names(my_rating_vector) <- all_movie_ids
# 2. Inject your 15 ratings into the correct movie slots
rated_item_names <- all_movie_ids[movie_ids_to_rate]
my_rating_vector[rated_item_names] <- my_15_ratings
# 3. Convert the full vector (1x1664) into a realRatingMatrix
myrating_aligned <- as(matrix(my_rating_vector,
nrow = 1,
dimnames = list(user = "MyUser", item = all_movie_ids)),
"realRatingMatrix")
cat("✅ Personalized ratings matrix successfully created and aligned.\n")
# ----------------------------------------------------------------------
# STEP 3: Perform UBCF and Predict Top 10 List
# ----------------------------------------------------------------------
# Train the UBCF model (using default cosine similarity and z-score normalization)
rec.ub <- Recommender(MovieLense, method = "UBCF")
# Predict the top 10 list (n=10) for your new user
pred.ub <- predict(rec.ub, myrating_aligned, n = 10, type = "topNList")
cat("\n✅ UBCF Model trained and Top 10 prediction made.\n")
# ----------------------------------------------------------------------
# STEP 4: Display the Top 10 Recommended Movies (Final Answer)
# ----------------------------------------------------------------------
# Convert the prediction to a list of movie IDs
recommended_movie_ids <- as.character(unlist(pred.ub@items))
# Get the movie titles and format the output
recommended_movies_table <- MovieLenseMeta %>%
filter(movie_id %in% recommended_movie_ids) %>%
select(movie_id, movie_title, release_date) %>%
# Use match() to order the results based on the prediction output
mutate(Rank = match(movie_id, recommended_movie_ids)) %>%
arrange(Rank) %>%
select(Rank, movie_title, release_date)
pred.ub
rec.ub
myrating
