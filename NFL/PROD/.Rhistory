# --- 2. Create a TEMPORARY vector of NA for all 1664 movies ---
# Get ALL item IDs (column names) from the MovieLense model
all_movie_ids <- colnames(MovieLense)
num_items <- length(all_movie_ids)
# Start with a vector of NA ratings for all items
full_ratings_vector <- rep(NA, num_items)
names(full_ratings_vector) <- all_movie_ids
# --- 3. Inject Your Ratings into the Full Vector ---
# Map your 15 ratings to the correct movie IDs (names)
