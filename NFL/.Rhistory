ylab = "Price",
pch = 19, col = "darkblue")
km.grid <- seq(from = min(df$KM), to = max(df$KM), by = 1000)
# We need to specify the value for 'Automatic'.
# The hint uses mean(Automatic), which is a common approach.
mean_automatic <- mean(df$Automatic)
preds <- predict(lm3, newdata = list(KM = km.grid, Automatic = rep(mean_automatic, length(km.grid))))
lines(km.grid, preds, col = "red", lwd = 2)
