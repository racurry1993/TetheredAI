#install.packages("AER")
library(AER)
setwd('C:/Users/rfo7799/Desktop/Git/GATechDS/MGT-6203/Homework4')
df <- read.csv('Education_data.csv')
str(df)
hist(df$wage, breaks=50)
hist(log(df$wage), breaks=50)
ols.res <- lm(log(wage)~educ+exper+I(exper^2), data=df)
summary(ols.res)
stage1 <- lm(educ~fatheduc+motheduc+exper+I(exper^2), data=df)
summary(stage1)
stage2 <- lm(log(wage)~fitted(stage1)+exper+I(exper^2), data=df)
summary(stage2)
TSLS.res <- ivreg(log(wage)~educ+exper+I(exper^2)|fatheduc+motheduc+exper+I(exper^2), data=df)
summary(TSLS.res)
cbind(coef(ols.res), coef(TSLS.res))
ols.res <- lm(log(wage)~educ+exper+I(exper^2), data=df)
summary(ols.res)
stage1 <- lm(educ~fatheduc+motheduc+exper+I(exper^2), data=df)
summary(stage1)
stage1 <- lm(educ~nearc4+exper+I(exper^2), data=df)
summary(stage1)
TSLS.res <- ivreg(log(wage)~educ+exper+I(exper^2)|nearc4+exper+I(exper^2), data=df)
summary(TSLS.res)
cbind(coef(ols.res), coef(TSLS.res))
TSLS.res <- ivreg(log(wage)~educ+exper+I(exper^2)|nearc4+exper+I(exper^2), data=df)
summary(TSLS.res)
ols.res <- lm(log(wage)~educ+exper+I(exper^2), data=df)
summary(ols.res)
cbind(coef(ols.res), coef(TSLS.res))
